table *Measures
	lineageTag: 7de996da-c5c2-4f7a-ad3f-2797dba59a08

	measure 'Cumulative Count' =
			
			CALCULATE(sum(Sheet1[Quantity]),ALLEXCEPT(Sheet1,Sheet1[Date_Bought]),YEAR(Sheet1[Date_Bought])<=SELECTEDVALUE(Dates[Year]))
		formatString: 0
		lineageTag: c8c312f4-a647-4aea-95dd-2c3741e9608e

	measure 'Cumulative Weight' =
			
			CALCULATE(sum(Sheet1[Total_Weight]),ALLEXCEPT(Sheet1,Sheet1[Date_Bought]),YEAR(Sheet1[Date_Bought])<=SELECTEDVALUE(Dates[Year]))
		lineageTag: 0f1404d1-53f7-4a91-b0b8-2f7ba5ca19b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Axis' =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),CALCULATE(sum(Sheet1[Quantity]),ALL(Sheet1))*1.15,
			        CALCULATE(sum(Sheet1[Total_Weight]),ALL(Sheet1))*1.15
			)
			// var _value = CALCULATE(sum(Sheet1[Quantity]),ALL(Sheet1))*1.15
			// return _value)
		lineageTag: 1188dffe-67e8-4c7a-a3c4-a0d85465830d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Difference =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),[Max Axis]-[Cumulative Count],
			        [Max Axis]-[Cumulative Weight]
			)
		lineageTag: 0267f3bc-5600-44c6-b892-1a95a3512345

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Flock Size' = CALCULATE(SUM(Sheet1[Quantity]),all(Sheet1))
		formatString: 0
		lineageTag: b45e41d8-5f83-49f7-994d-d6233c50b92f

	measure 'Flock Weight' = CALCULATE(SUM(Sheet1[Total_Weight]),all(Sheet1))/1000
		lineageTag: e41aa4a5-efae-4a83-8400-36d27cb849a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Past Year' = CALCULATE(SUM(Sheet1[Quantity]),ALLEXCEPT(Sheet1,Sheet1[Date_Bought]),year(Sheet1[Date_Bought])=year(max(Sheet1[Date_Bought])))
		formatString: 0
		lineageTag: e3888411-43b3-4350-858a-dadc945fe9fb

	measure 'Flock Height' = CALCULATE(SUM(Sheet1[Height]),all(Sheet1))/100
		formatString: 0.0
		lineageTag: 0a20451c-1c1f-4533-851a-6a9fbf79f58a

	measure 'Flock Length' = CALCULATE(SUM(Sheet1[Length]),all(Sheet1))/100
		formatString: 0.0
		lineageTag: 87cb69a9-c587-4190-bf54-5be0b33dafc6

	measure QuantityWeightSwitch =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),sum(Sheet1[Quantity]),
			        sum(Sheet1[Total_Weight])
			)
		lineageTag: 58a8217f-d0f8-4bb9-8367-1f9132af7100

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Title Individual Year QuantWeight' =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),"New Additions in Each Year",
			        "Added Weight in Each Year (g)"
			)
		lineageTag: ca967319-3040-4d18-9261-2430ee817dda

	measure 'Title Cumulative Year QuantWeight' =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),"Cumulative Flock Size by Year",
			        "Cumulative Flock Weight by Year"
			)
		lineageTag: 8aa76d80-824c-4ab7-a7fd-338d549fab66

	column *Measures
		dataType: string
		lineageTag: 61a4a6c4-c282-4b8a-ab2c-2170885a545c
		summarizeBy: none
		sourceColumn: *Measures

		annotation SummarizationSetBy = Automatic

	partition *Measures = m
		mode: import
		source =
				let
				    Source = ""
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

