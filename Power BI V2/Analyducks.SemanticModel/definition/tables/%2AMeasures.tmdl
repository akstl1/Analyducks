table *Measures
	lineageTag: 7de996da-c5c2-4f7a-ad3f-2797dba59a08

	measure 'Cumulative Count' =
			
			CALCULATE(sum(DuckData[Quantity]),ALLEXCEPT(DuckData,DuckData[Date_Bought]),YEAR(DuckData[Date_Bought])<=SELECTEDVALUE(Dates[Year]))
		formatString: 0
		lineageTag: c8c312f4-a647-4aea-95dd-2c3741e9608e

	measure 'Cumulative Weight' =
			
			CALCULATE(sum(DuckData[Total_Weight]),ALLEXCEPT(DuckData,DuckData[Date_Bought]),YEAR(DuckData[Date_Bought])<=SELECTEDVALUE(Dates[Year]))
		lineageTag: 0f1404d1-53f7-4a91-b0b8-2f7ba5ca19b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Axis' =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),CALCULATE(sum(DuckData[Quantity]),ALL(DuckData))*1.15,
			        CALCULATE(sum(DuckData[Total_Weight]),ALL(DuckData))*1.15
			)
			// var _value = CALCULATE(sum(Sheet1[Quantity]),ALL(Sheet1))*1.15
			// return _value)
		lineageTag: 1188dffe-67e8-4c7a-a3c4-a0d85465830d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Difference =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),[Max Axis]-[Cumulative Count],
			        [Max Axis]-[Cumulative Weight]
			)
		lineageTag: 0267f3bc-5600-44c6-b892-1a95a3512345

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Flock Size' = CALCULATE(SUM(DuckData[Quantity]),all(DuckData))
		formatString: 0
		lineageTag: b45e41d8-5f83-49f7-994d-d6233c50b92f

	measure 'Flock Weight' = CALCULATE(SUM(DuckData[Total_Weight]),all(DuckData))/1000
		lineageTag: e41aa4a5-efae-4a83-8400-36d27cb849a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Past Year' = CALCULATE(SUM(DuckData[Quantity]),ALLEXCEPT(DuckData,DuckData[Date_Bought]),year(DuckData[Date_Bought])=year(max(DuckData[Date_Bought])))
		formatString: 0
		lineageTag: e3888411-43b3-4350-858a-dadc945fe9fb

	measure 'Flock Height' = CALCULATE(SUM(DuckData[Height]),all(DuckData))/100
		formatString: 0.0
		lineageTag: 0a20451c-1c1f-4533-851a-6a9fbf79f58a

	measure 'Flock Length' = CALCULATE(SUM(DuckData[Length]),all(DuckData))/100
		formatString: 0.0
		lineageTag: 87cb69a9-c587-4190-bf54-5be0b33dafc6

	measure QuantityWeightSwitch =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),sum(DuckData[Quantity]),
			        sum(DuckData[Total_Weight])
			)
		lineageTag: 58a8217f-d0f8-4bb9-8367-1f9132af7100

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Title Individual Year QuantWeight' =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),"New Additions in Each Year",
			        "Added Weight in Each Year (g)"
			)
		lineageTag: ca967319-3040-4d18-9261-2430ee817dda

	measure 'Title Cumulative Year QuantWeight' =
			
			SWITCH(TRUE(),
			        CONTAINSSTRING(SELECTEDVALUE(ParamCumulativeQuantityWeight[ParamQuantityWeight Fields]),"Count"),"Cumulative Flock Size by Year",
			        "Cumulative Flock Weight by Year"
			)
		lineageTag: 8aa76d80-824c-4ab7-a7fd-338d549fab66

	measure LWHweight =
			
			var _duck = SELECTEDVALUE(DuckData[Name])
			var _length = CONVERT(CALCULATE(max(DuckData[Length]),DuckData[Name]=_duck),STRING)
			var _width = CONVERT(CALCULATE(max(DuckData[Width]),DuckData[Name]=_duck),STRING)
			var _height = CALCULATE(max(DuckData[Height]),DuckData[Name]=_duck)
			var _weight = CALCULATE(max(DuckData[Total_Weight]),DuckData[Name]=_duck)
			var _final = CONCATENATE(_length,"x")
			return _final
			// CONVERT(_length,STRING)&" x "
			// &_width&" x "&_height&"cm || "&_weight&"g"
		lineageTag: ec929d33-723b-4ca0-85bc-c24bd24f26e8

	measure pictest = "https://github.com/akstl1/Analyducks/blob/main/Power%20BI%20V2/Images/DuckPNG.png"
		lineageTag: ee963460-40de-4219-bc17-1040b18a09d4
		dataCategory: ImageUrl

	measure 'kg Comparison' =
			
			SWITCH(TRUE(),
			        ROUNDDOWN([Flock Weight],0)>4 && ROUNDDOWN([Flock Weight],0)<=12, "bag of flour",
			        ROUNDDOWN([Flock Weight],0)>12 && ROUNDDOWN([Flock Weight],0)<=17, "large watermelon",
			        ROUNDDOWN([Flock Weight],0)>17 && ROUNDDOWN([Flock Weight],0)<=22, "5 gallon water jug",
			        ROUNDDOWN([Flock Weight],0)>22 && ROUNDDOWN([Flock Weight],0)<=27, "2 gold bars",
			        ROUNDDOWN([Flock Weight],0)>27 && ROUNDDOWN([Flock Weight],0)<=32, "fully grown dwarf goat",
			        ".....lot of ducks"
			)
		lineageTag: 81d9aa4f-a484-4ce7-90d5-ee32184c86be

	measure 'Past year %' = 100*([Past Year])/([Flock Size]-[Past Year])
		lineageTag: 3939e498-3a46-4d53-88d4-58aa9ddfed18

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Ducks Per Year' =
			
			MAXX(
			    SUMMARIZE(
			        'DuckData',
			        Dates[Year],
			        "Total Qty",
			        SUM(DuckData[Quantity])
			    ),
			    [Total Qty]
			)
		formatString: 0
		lineageTag: 4bad40a7-ddd9-4202-a6b7-11be690b71fd

	measure 'Countries of Purchase' = DISTINCTCOUNT(DuckData[Purchase_Country])
		formatString: 0
		lineageTag: 36d2305c-8d85-4952-83d9-a7ce17002b29

	measure Donors = DISTINCTCOUNT(DuckData[Buyer])
		formatString: 0
		lineageTag: 0f2cb320-ae60-4e68-b173-b40129c008c2

	measure 'States of Purchase' = CALCULATE(DISTINCTCOUNT(DuckData[Purchase_State]),DuckData[Purchase_Country]="USA")
		formatString: 0
		lineageTag: d4ca819e-0971-4956-994e-2ae6b3fac962

	column *Measures
		dataType: string
		lineageTag: 61a4a6c4-c282-4b8a-ab2c-2170885a545c
		summarizeBy: none
		sourceColumn: *Measures

		annotation SummarizationSetBy = Automatic

	partition *Measures = m
		mode: import
		source =
				let
				    Source = ""
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

